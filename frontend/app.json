{
  "expo": {
    "name": "FitLog",
    "slug": "FitLogApp",
    "displayName": "FitLog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "fitlogapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "buildNumber": "2",
      "bundleIdentifier": "com.anonymous.FitLogApp",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "KAKAO_APP_KEY": "e889ccffb6096521a6b49b9774f4d9ab",
        "KAKAO_APP_SCHEME": "kakaoe889ccffb6096521a6b49b9774f4d9ab",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "fitlogapp"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "kakaoe889ccffb6096521a6b49b9774f4d9ab"
            ]
          }
        ],
        "LSApplicationQueriesSchemes": [
          "kakaokompassauth",
          "kakaolink",
          "storykompassauth"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSPhotoLibraryUsageDescription": "운동 사진/영상을 갤러리에 저장하기 위해 접근이 필요해요.",
        "NSPhotoLibraryAddUsageDescription": "운동 사진/영상을 갤러리에 저장하기 위해 접근이 필요해요."
      }
    },
    "android": {
      "package": "com.anonymous.FitLogApp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#2e8b57",
        "foregroundImage": "./assets/images/logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "운동 기록에 사진/영상을 첨부하기 위해 갤러리 접근이 필요해요.",
          "cameraPermission": "운동 기록에 사진/영상을 촬영하기 위해 카메라 접근이 필요해요.",
          "microphonePermission": "영상 녹화를 위해 마이크 접근이 필요해요."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "운동 사진/영상을 갤러리에 저장하기 위해 접근이 필요해요.",
          "savePhotosPermission": "운동 사진/영상을 갤러리에 저장하기 위해 접근이 필요해요.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "e889ccffb6096521a6b49b9774f4d9ab"
        }
      ],
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "e889ccffb6096521a6b49b9774f4d9ab"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "151c2a5a-ed41-45e5-8a7b-8c0ac0c871e9"
      }
    }
  }
}
